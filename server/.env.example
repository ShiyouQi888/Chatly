# Chatly 后端配置
#
# 这个文件是**模板**，复制成 server/.env 再改（server/.env 已在 .gitignore 里）。
# 全部留空也能跑 —— 默认就是「本地开发」那一套（SQLite + 单进程内存）。
#
# 加载方式见 server/src/env.js：进程启动时读 server/.env，
# **已经存在的环境变量优先**（所以 `DB_DRIVER=postgres node src/index.js`
# 这种临时覆盖不会被文件里的值盖掉）。

# ============ 数据库 ============
# sqlite（默认，本地开发与全部自检）| postgres（线上）
# DB_DRIVER=sqlite
# DB_DRIVER=postgres
#
# 仅 postgres 需要。对应 docker-compose.yml 起出来的实例。
# DATABASE_URL=postgres://chatly:chatly_dev_pw@127.0.0.1:55433/chatly
#
# 连接池上限。默认 10 —— 一个单进程 Node 服务够用了；
# 进程数 × 这个值不要超过 PG 的 max_connections(默认 100)。
# PG_POOL_MAX=10
#
# 仅 sqlite 需要（一般不用改）
# DB_PATH=./data/chatly.db

# ============ Redis ============
# 不设 = **不进 Redis 模式**：在线状态退化成单进程内存、广播退化成进程内直发。
# 本地开发和自检就是这样跑的 —— 少了这个降级，没起容器的人一步都走不动。
# REDIS_URL=redis://127.0.0.1:6380
#
# 在线状态的存活窗口（秒）。**服务端**按 TTL/3 自动续期，所以这里不用配心跳间隔。
# 为什么要 TTL 而不是只靠断开事件：进程被 kill -9 时收不到 close，
# 那条存在 Redis 里的「在线」记录就只能靠过期自己消失。
# 默认 45s —— 连丢两次心跳才判过期，网络抖一下不会闪断。
# PRESENCE_TTL=45

# ============ 服务 ============
# PORT=3002
# JWT_SECRET=（生产必须改，默认值只用于本地）
# JWT_EXPIRES_IN=7d
# 验证码签名密钥，生产环境必须设置为独立的随机密钥；至少 32 字节。
# AUTH_OTP_SECRET=
# 固定运营后台管理员账号（Chatly 用户名或数字 ID），仅配置一个账号。
# 首次启动创建固定后台账号；已初始化后，账号密码可在后台修改且不会被重置。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-at-least-12-random-characters
# ADMIN_NICKNAME=运营管理员
# 管理台 /qishiyou 使用独立后台账号与会话，支持邮箱格式账号，不需要先注册普通用户。
# 环境变量不变时保留后台修改；改变 ADMIN_USERNAME / ADMIN_PASSWORD 后重启会重置管理员凭据。

# ============ 消息隐私 ============
# 32 字节随机密钥（64 位十六进制）。配置后，用户可以开启文字消息数据库加密。
# 生产环境请使用密钥管理服务保存，并妥善备份；密钥丢失后加密消息无法恢复。
# MESSAGE_ENCRYPTION_KEY=

# ============ 第三方 ============
# 邮箱注册验证码通过 Resend 发送。需要已验证发件域名；未配置时邮箱注册接口会返回未配置提示。
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=Chatly <no-reply@example.com>
#
# 手机号注册验证码通过 Twilio SMS 发送。需配置可用的账号、Token 和短信发送号码。
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
#
# 腾讯位置服务的 key，**只在服务端用**（逆地址解析 / POI 搜索）。
# 不配不是错误：相关接口返回 200 + {configured:false,reason}。
# TENCENT_MAP_KEY=

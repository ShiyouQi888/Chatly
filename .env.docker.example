# 复制到项目根目录 .env 并替换强随机密钥。不要提交真实 .env。
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_SECRET=replace-with-another-at-least-32-random-bytes

# 首次启动创建固定后台账号（必须改成自己的账号和至少 12 位随机密码）
# 初始化后可在运营后台自行修改账号和密码；数据库中已初始化的管理员不会被容器重启覆盖。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NICKNAME=运营管理员

# 可选：旧版本管理员迁移用；新部署请使用上面的 ADMIN_USERNAME / ADMIN_PASSWORD
ADMIN_ACCOUNT=

# 可选：加密、地图及验证码服务
MESSAGE_ENCRYPTION_KEY=
TENCENT_MAP_KEY=
VITE_TMAP_KEY=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 可选：公网反向代理端口、PostgreSQL 连接池大小
CHATLY_BIND_ADDRESS=127.0.0.1
CHATLY_HTTP_PORT=8080
PG_POOL_MAX=10

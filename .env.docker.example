# 复制到项目根目录 .env 并替换强随机密钥。不要提交真实 .env。
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_SECRET=replace-with-another-at-least-32-random-bytes

# 可选：后台、加密、地图及验证码服务
ADMIN_USER_IDS=
MESSAGE_ENCRYPTION_KEY=
TENCENT_MAP_KEY=
VITE_TMAP_KEY=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 可选：公网反向代理端口、PostgreSQL 连接池大小
CHATLY_BIND_ADDRESS=127.0.0.1
CHATLY_HTTP_PORT=8080
PG_POOL_MAX=10

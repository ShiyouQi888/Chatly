# 复制到项目根目录 .env 并替换强随机密钥。不要提交真实 .env。
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_OTP_SECRET=replace-with-another-at-least-32-random-bytes

# 首次启动创建独立后台账号（支持邮箱格式；密码至少 12 位）
# 在 /qishiyou 独立登录；账号不属于普通用户体系，也不需要注册 Chatly 用户。
# 后台可修改凭据；环境变量不变时重启保留后台修改，改变环境变量则重置管理员凭据。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
ADMIN_NICKNAME=运营管理员

# 升级时自动复制旧后台管理员/成员凭据到独立账号表；无需配置普通用户 ID。

# 可选：加密、地图及验证码服务
MESSAGE_ENCRYPTION_KEY=
TENCENT_MAP_KEY=
VITE_TMAP_KEY=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 可选：浏览器后台来电推送（使用 `npx web-push generate-vapid-keys --json` 生成）
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# WebRTC 网络穿透。
#
# 没有 TURN 时，同城/家庭网络大多能连上；两端都在对称 NAT 或企业网里就必然失败，
# 表现是「一直正在接通」，而两端都看不出错。所以公网部署请把 turn 服务一起起来。
#
# 三个值要与 compose 里的 turn 服务对齐：
#   WEBRTC_TURN_SHARED_SECRET  → turn 的 --static-auth-secret（同一个值，用 openssl rand -hex 32 生成）
#   WEBRTC_TURN_URLS           → turn:公网IP:3478?transport=udp,turn:公网IP:3478?transport=tcp
#   TURN_EXTERNAL_IP           → 公网 IP，并在 compose 里取消 --external-ip 的注释
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
TURN_EXTERNAL_IP=

# 可选：公网反向代理端口、PostgreSQL 连接池大小
CHATLY_BIND_ADDRESS=127.0.0.1
CHATLY_HTTP_PORT=8080
PG_POOL_MAX=10
